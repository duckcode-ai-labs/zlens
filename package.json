{
  "name": "dql",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/duckcode-ai-labs/zlens.git"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "node --test scripts/license-files.test.mjs scripts/release-workspace-ranges.test.mjs scripts/release-packages.test.mjs scripts/release-publish-guards.test.mjs scripts/docs-clips.test.mjs && turbo run test",
    "clean": "turbo run clean",
    "release:dry-run": "pnpm build && pnpm test && node ./scripts/release-packages.mjs --dry-run",
    "release:publish": "node ./scripts/release-packages.mjs --publish",
    "test:install:published": "node ./scripts/smoke-cli-install.mjs",
    "release:extension": "pnpm --filter dql-language-support package",
    "perf:scale:unit": "node --test scripts/performance/dql2-scale-fixture.test.mjs",
    "perf:scale": "node scripts/performance/dql2-scale-benchmark.mjs",
    "test:perf:scale": "pnpm build && node scripts/performance/dql2-scale-benchmark.mjs --gate",
    "docs:clips": "node scripts/docs-clips.mjs"
  },
  "dependencies": {
    "@zlens/cli": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.4.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "overrides": {
      "@types/node": "^22.0.0",
      "body-parser@2": "^2.4.0",
      "fast-uri@3": "^3.1.9",
      "hono@4": "^4.12.34",
      "ip-address@10": "^10.7.6",
      "js-yaml@4": "^4.3.2",
      "lodash": "^4.18.1",
      "zod": "^4.6.6",
      "qs@6": "^6.16.1",
      "@hono/node-server@1": "^1.19.18",
      "yaml@2": "^2.8.3"
    }
  }
}
