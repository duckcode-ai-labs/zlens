{
  "name": "@zlens/ui",
  "version": "0.2.4",
  "description": "Design tokens, theme provider, and headless primitives for the ZLens notebook + dashboard shell",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js"
    },
    "./styles": "./src/styles/globals.css",
    "./styles/tokens": "./src/styles/tokens.css",
    "./styles/fonts": "./src/styles/fonts.css",
    "./font-licence": {
      "types": "./src/styles/font-licence.d.mts",
      "default": "./src/styles/font-licence.mjs"
    }
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prepack": "node ../../scripts/package-license-files.mjs"
  },
  "files": [
    "dist",
    "src/styles",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/duckcode-ai-labs/zlens.git",
    "directory": "packages/dql-ui"
  },
  "homepage": "https://github.com/duckcode-ai-labs/zlens",
  "bugs": {
    "url": "https://github.com/duckcode-ai-labs/zlens/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.4",
    "lucide-react": "^0.563.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
